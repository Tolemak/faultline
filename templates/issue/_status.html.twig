<div id="issue-status" class="status status--{{ issue.status.value }}">
    <span class="status__label">{{ ('status.' ~ issue.status.value)|trans }}</span>
    <form method="post" action="{{ path('app_issue_status', {slug: project.slug, id: issue.id}) }}" class="status__actions">
        <input type="hidden" name="_token" value="{{ csrf_token('issue_status_' ~ issue.id) }}">
        {% if issue.status.value == 'unresolved' %}
            <button type="submit" name="action" value="resolve" class="button button--primary"{{ demo_mode() ? ' disabled' }}>{{ 'issue.resolve'|trans }}</button>
            <button type="submit" name="action" value="ignore" class="button"{{ demo_mode() ? ' disabled' }}>{{ 'issue.ignore'|trans }}</button>
        {% else %}
            <button type="submit" name="action" value="reopen" class="button"{{ demo_mode() ? ' disabled' }}>{{ 'issue.reopen'|trans }}</button>
        {% endif %}
    </form>
</div>
