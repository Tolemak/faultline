{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
    <section class="login">
        <svg class="login__trace" viewBox="0 0 320 60" aria-hidden="true" preserveAspectRatio="none">
            <polyline points="0,30 60,30 72,26 84,34 96,30 140,30 150,8 160,54 170,14 180,46 190,30 240,30 250,24 258,36 266,30 320,30"/>
        </svg>
        <h1>{{ 'login.title'|trans }}</h1>
        {% if error %}
            <p class="flash flash--error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        {% endif %}
        <form method="post" action="{{ path('app_login') }}" class="form" data-turbo="false">
            <label class="field">
                <span>{{ 'login.username'|trans }}</span>
                <input type="text" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
            </label>
            <label class="field">
                <span>{{ 'login.password'|trans }}</span>
                <input type="password" name="_password" autocomplete="current-password" required>
            </label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="button button--primary">{{ 'login.submit'|trans }}</button>
        </form>
    </section>
{% endblock %}
